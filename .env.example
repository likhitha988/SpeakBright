# SpeakBright works fully WITHOUT any of these settings.
# Copy this file to ".env.local" only if you want the OPTIONAL AI English tutor.
#
# The key is read on the server only (app/api/feedback/route.ts).
# It is never sent to the browser. Never commit your real key.

# Anthropic API key (leave empty to keep the AI tutor switched off)
ANTHROPIC_API_KEY=

# Optional: which model to use for tutor replies (default: claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
